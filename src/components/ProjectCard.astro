---
import type { CollectionEntry } from 'astro:content';
import { url } from '../lib/url';
interface Props { project: CollectionEntry<'projects'>; index: number }
const { project: p, index } = Astro.props;
const d = p.data;
const themeLabel: Record<string, string> = { forecast: 'Forecasting', platform: 'Decision platform', 'earth-observation': 'Earth observation', operations: 'Operational intelligence', ai: 'AI × environment', science: 'Open science' };
const coord = `${Math.abs(d.location.lat).toFixed(2)}° ${d.location.lat >= 0 ? 'N' : 'S'} · ${Math.abs(d.location.lon).toFixed(2)}° ${d.location.lon >= 0 ? 'E' : 'W'}`;
---
<a class={`card theme-${d.theme}`} href={url(`/work/${p.id}`)} data-track="Project viewed" data-track-props={JSON.stringify({ project: p.id })} style={`view-transition-name: cover-${p.id}`}>
  <div class="card-media">
    {d.cover ? <img class:list={{ paper: d.cover.paper }} src={url(d.cover.src)} alt="" loading={index < 2 ? 'eager' : 'lazy'} decoding="async" width="1600" height="900" /> : <svg class="card-diagram" viewBox="0 0 320 180" aria-hidden="true">
      <g class="nodes">{[0,1,2,3].map((i) => <g><rect x={24 + i * 74} y={d.theme === 'ai' ? 70 : 40 + (i % 2) * 40} width="56" height="30" rx="4" />{i < 3 && <path d={`M${80 + i * 74} ${d.theme === 'ai' ? 85 : 55 + (i % 2) * 40} L${98 + i * 74} ${d.theme === 'ai' ? 85 : 55 + ((i + 1) % 2) * 40}`} />}</g>)}</g>
      {d.theme === 'ai' ? <path class="loop" d="M302 100 v40 H52 v-30" /> : <path class="loop" d="M24 150 H296" />}
    </svg>}
    <div class="card-layer" aria-hidden="true"></div>
    <span class="card-coord mono" aria-hidden="true">{coord}</span>
  </div>
  <div class="card-body">
    <div class="card-meta mono"><span>{themeLabel[d.theme]}</span><span>{d.organisation}</span><span>{d.years}</span></div>
    <h3>{d.title}</h3>
    <p>{d.summary}</p>
    {d.metrics.length > 0 && (
      <ul class="card-metrics">
        {d.metrics.slice(0, 2).map((m) => <li><strong>{m.value}</strong><span>{m.label}</span></li>)}
      </ul>
    )}
    <span class="card-cta">Read the case</span>
  </div>
</a>
<style>
  .card { display: grid; grid-template-rows: auto 1fr; text-decoration: none; color: inherit; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); overflow: hidden; transition: border-color var(--t-ui) var(--ease), transform var(--t-ui) var(--ease); }
  .card:hover, .card:focus-visible { border-color: var(--line-strong); }
  .card-media { position: relative; aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg-2); }
  .card-media img.paper { object-fit: contain; background: #f3f0e8; padding: 0.75rem; }
  .card-media img { width: 100%; height: 100%; object-fit: cover; object-position: top left; filter: saturate(0.85) contrast(1.02); transition: transform var(--t-story) var(--ease), filter var(--t-story) var(--ease); }
  .card:hover .card-media img { transform: scale(1.03) translate(-1%, -1%); filter: saturate(1) contrast(1.02); }
  /* Environmental layer that fades in on hover — a hint of the case's own colour */
  .card-layer { position: absolute; inset: 0; opacity: 0; mix-blend-mode: screen; transition: opacity var(--t-story) var(--ease);
    background: radial-gradient(60% 80% at 70% 60%, color-mix(in srgb, var(--accent) 45%, transparent), transparent 70%); }
  .card:hover .card-layer { opacity: 0.35; }
  .card-coord { position: absolute; left: 0.75rem; bottom: 0.6rem; font-size: var(--fs-xs); color: var(--text); background: rgba(15,19,24,.7); padding: 0.15rem 0.45rem; border-radius: 3px; opacity: 0; transform: translateY(4px); transition: opacity var(--t-ui) var(--ease), transform var(--t-ui) var(--ease); }
  .card:hover .card-coord { opacity: 1; transform: none; }
  .card-diagram { position: absolute; inset: 0; width: 100%; height: 100%; }
  .card-diagram rect { fill: var(--surface); stroke: var(--line-strong); } .card-diagram g g:last-child rect { stroke: var(--accent); fill: rgba(46,196,182,.15); }
  .card-diagram path { fill: none; stroke: var(--accent); stroke-width: 1; opacity: .7; } .card-diagram .loop { stroke-dasharray: 3 6; opacity: .4; }
  .card-body { padding: 1.25rem 1.4rem 1.4rem; display: grid; gap: 0.6rem; align-content: start; }
  .card-meta { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; font-size: var(--fs-xs); color: var(--muted); }
  .card-meta span:first-child { color: var(--accent); }
  .card h3 { margin: 0; font-size: var(--fs-md); }
  .card p { margin: 0; color: var(--text-2); font-size: var(--fs-sm); }
  .card-metrics { list-style: none; margin: 0.35rem 0 0; padding: 0; display: flex; gap: 1.5rem; }
  .card-metrics strong { display: block; font-family: var(--font-display); font-size: var(--fs-md); letter-spacing: -0.02em; }
  .card-metrics span { font-size: var(--fs-xs); color: var(--muted); display: block; max-width: 18ch; }
  .card-cta { margin-top: 0.4rem; font-size: var(--fs-sm); font-weight: 500; color: var(--accent); }
</style>
