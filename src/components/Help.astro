---
import { url } from '../lib/url';
const services = [
  { name: 'Geospatial intelligence', outcome: 'Fragmented geographic data becomes operational maps, WebGIS and dashboards your team actually opens.', ex: 'Montesinho WebGIS · forestry dashboards' },
  { name: 'Earth observation', outcome: 'The satellite archive becomes monitoring: land cover, vegetation and change over twenty years, in the cloud.', ex: 'Habitat trends 2001–2021 · Montrends' },
  { name: 'Environmental modelling', outcome: 'Species, climate and land use become scenarios you can compare and defend.', ex: '10,000+ species · CLUMondo at 1 km' },
  { name: 'Decision systems & AI', outcome: 'Analysis becomes a tool — a scenario explorer, a predictive dashboard, an AI workflow with a specialist in the loop.', ex: 'ODT workflow · AI evaluation' },
];
---
<section class="section help" id="help" aria-labelledby="help-title">
  <div class="container">
    <header class="section-head">
      <span class="index">How I can help</span>
      <h2 id="help-title">Four kinds of problem I take on</h2>
      <p class="lede">Described by what you get, not by the software. If your organisation has spatial or environmental data and a decision that depends on it, one of these is probably the shape of the job.</p>
    </header>
    <ol class="services">
      {services.map((s) => (
        <li>
          <h3>{s.name}</h3>
          <p>{s.outcome}</p>
          <span class="mono ex">{s.ex}</span>
        </li>
      ))}
    </ol>
    <p class="tail"><a class="btn btn-ghost" href={url('/work')}>See the six case studies</a></p>
  </div>
</section>
<style>
  .services { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .services li { padding: 1.75rem 1.5rem 1.75rem 0; border-right: 1px solid var(--line); margin-right: 1.5rem; }
  .services li:last-child { border-right: 0; margin-right: 0; }
  .services h3 { font-size: var(--fs-md); margin-bottom: 0.5rem; }
  .services p { color: var(--text-2); font-size: var(--fs-sm); margin-bottom: 0.8rem; }
  .ex { font-size: var(--fs-xs); color: var(--muted); }
  @media (max-width: 700px) { .services li { border-right: 0; margin-right: 0; border-bottom: 1px solid var(--line); } .services li:last-child { border-bottom: 0; } }
</style>
